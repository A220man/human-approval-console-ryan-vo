# Environment Mode: development | production | testing
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Local-only Demo Mode (Startup will REFUSE demo mode if ENVIRONMENT=production or non-localhost)
DEMO_MODE=true

# Server Session & CSRF Security (Leave blank in template, operator generates 32+ byte hex secrets)
SECRET_KEY=
RECEIPT_SIGNING_KEY=

# Keycloak OIDC Authentication Settings (Real OIDC Flow)
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/approval-console
OIDC_CLIENT_ID=approval-console-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
OIDC_SCOPES=openid email profile roles

# Optional Grounded LLM Advisory Provider Settings
# Supported providers: openai-compatible | anthropic | gemini | ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.8-27b
LLM_BASE_URL=https://llm.chris-vo.com/v1
# LLM_API_KEY is the ONLY LLM credential variable. Keep blank in template.
LLM_API_KEY=

# Persistent SQLite Storage
DATABASE_PATH=backend/data/approval_console.db
